# ==========================================
# 1. Environment & Sensitive Credentials
# ==========================================
.env
.env.*
!.env.example
.env.backup
.env.production
Homestead.json
Homestead.yaml
/auth.json
*.pem
*.key
*.crt

# ==========================================
# 2. Dependencies & Package Managers
# ==========================================
/vendor/
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 3. Build & Compiled Frontend Assets
# ==========================================
/public/build/
/public/hot
/public/storage
.vite/

# ==========================================
# 4. Laravel Storage & Framework Caches
# ==========================================
/storage/*.key
/storage/pail
/storage/debugbar/
/storage/framework/views/*.php
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# ==========================================
# 5. Local Databases & Dumps
# ==========================================
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sql

